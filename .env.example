# ecosystem-kb — local deployment configuration template.
# `kb setup` copies this to .env (never the reverse) and fills secrets.

# --- Runtime ---
KB_ENVIRONMENT=production
KB_NAMESPACE=ecosystem_prod

# --- PostgreSQL (control plane; generated by kb setup) ---
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP

# --- FalkorDB (graph store; generated by kb setup) ---
FALKORDB_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP

# --- Inference providers (REQUIRED for ingestion/extraction) ---
# Without these the KB runs read-only: search/context work, capture queues
# but does not extract. kb setup and kb doctor surface this clearly.
KB_LLM_PROVIDER=openai
KB_LLM_MODEL=gpt-5.2
KB_LLM_API_KEY=
KB_EMBEDDER_MODEL=text-embedding-3-small

# --- Local API access (loopback only; ADR-019) ---
# The compose stack publishes the API on this host address/port ONLY.
# 127.0.0.1 keeps it unreachable from the LAN; the host CLI, `kb doctor`
# and MCP Inspector use exactly these values.
KB_BIND_HOST=127.0.0.1
KB_BIND_PORT=8000

# --- Host CLI admin credential (generated by kb setup; ADR-019) ---
# Seeds the kb-admin client inside the API container at startup; the CLI
# uses it for /v1/admin/* operations. Never commit the real value.
KB_ADMIN_TOKEN=CHANGE_ME_GENERATED_BY_SETUP

# --- Cloudflare named tunnel (optional; fill after dashboard setup, WP-C) ---
# CF_TUNNEL_TOKEN=...
# KB_PUBLIC_URL=https://kb.example.com

# NOTE on legacy variables: KB_DATABASE_URL, KB_GRAPH_HOST/PORT/PASSWORD and
# KB_API_TOKENS are still honored for the self-hosted VM profile
# (deploy/compose.yaml) and local dev. The local profile derives them from
# the values above; KB_API_TOKENS must stay empty in production (clients
# use per-client tokens from the registry).
