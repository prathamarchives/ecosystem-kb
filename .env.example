# --- Control plane (PostgreSQL in production; SQLite for local dev) ---
KB_DATABASE_URL=sqlite+aiosqlite:///./data/kb_dev.db
# Production example:
# KB_DATABASE_URL=postgresql+asyncpg://kb:PASSWORD@host:5432/ecosystem_kb

# --- Graph store (FalkorDB) ---
KB_GRAPH_HOST=127.0.0.1
KB_GRAPH_PORT=6379
KB_GRAPH_PASSWORD=
KB_GRAPH_DATABASE=ecosystem_prod

# --- Gateway ---
KB_API_TOKENS=local-dev-token-1
KB_DEFAULT_NAMESPACE=ecosystem_prod
KB_ALLOWED_NAMESPACES=ecosystem_dev,ecosystem_test,ecosystem_prod

# --- LLM / embeddings (inference providers; required in production) ---
KB_LLM_PROVIDER=openai
KB_LLM_MODEL=gpt-5.2
KB_LLM_API_KEY=
KB_EMBEDDER_MODEL=text-embedding-3-small
